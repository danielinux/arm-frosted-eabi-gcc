+    FILE *f = fopen(filename, "r");
+    char line[256];
+    if (!f)
+        fatal_perror("Can't open exports file '%s'", filename);
+    while (fgets(line, sizeof(line), f)) {
+        char *p = line;
+        while (*p && (*p == ' ' || *p == '\t')) p++;
+        /* skip empty lines and comments */
+        if (*p == '\0' || *p == '\n' || *p == '#')
+            continue;
+        /* trim newline */
+        char *nl = strchr(p, '\n');
+        if (nl) *nl = '\0';
+        export_symbols = realloc(export_symbols, (n_exports + 1) * sizeof(char *));
+        export_symbols[n_exports++] = strdup(p);
+    }
+    fclose(f);
