+    while (fgets(line, sizeof(line), f)) {
+        char *p = line;
+        while (*p && (*p == ' ' || *p == '\t')) p++;
+        if (*p == '\0' || *p == '\n' || *p == '#')
+            continue;
+        char *nl = strchr(p, '\n');
+        if (nl) *nl = '\0';
+        /* LIB_ID=N header */
+        if (strncmp(p, "LIB_ID=", 7) == 0) {
+            map_lib_id = atoi(p + 7);
+            if (map_lib_id == 0)
+                fatal("Invalid LIB_ID in import map '%s'", filename);
+            continue;
+        }
+        /* symbol=ordinal */
+        char *eq = strchr(p, '=');
+        if (!eq)
+            fatal("Bad line in import map '%s': %s", filename, p);
+        *eq = '\0';
+        if (map_lib_id == 0)
+            fatal("Import map '%s' missing LIB_ID header", filename);
+        imports = realloc(imports, (n_imports + 1) * sizeof(struct import_entry));
+        imports[n_imports].symbol = strdup(p);
+        imports[n_imports].lib_id = map_lib_id;
+        imports[n_imports].ordinal = atoi(eq + 1);
+        n_imports++;
+    }
+    fclose(f);
